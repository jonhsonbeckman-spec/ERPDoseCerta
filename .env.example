# ============================================================
# CONFIGURAÇÃO OBRIGATÓRIA - DOSECERTA ERP
# ============================================================
# O sistema REQUER Supabase para funcionar.
# Não há modo de demonstração ou dados locais.
# ============================================================

# URL do seu projeto Supabase
# Encontre em: Settings > API > Project URL
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima (pública) do Supabase
# Encontre em: Settings > API > anon public key
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# ============================================================
# INSTRUÇÕES DE CONFIGURAÇÃO INICIAL
# ============================================================
# 
# 1. Crie um projeto em https://supabase.com
# 
# 2. Execute o schema SQL:
#    - Vá em SQL Editor no Supabase
#    - Copie e execute o conteúdo de supabase/schema.sql
# 
# 3. Crie o primeiro usuário Admin:
#    - Vá em Authentication > Users > Add User
#    - Crie um usuário com email e senha
#    - Copie o email criado
#    - Execute supabase/seed-admin.sql (substitua o email)
# 
# 4. Copie este arquivo para .env e preencha as variáveis
# 
# 5. Execute: npm run dev
# 
# 6. Faça login com o usuário Admin criado
# 
# 7. Use o painel "Gestão de Usuários" para criar operadores
# 
# ============================================================
